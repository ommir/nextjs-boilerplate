# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of your backend API. The bundled services fall back to in-memory
# mock data when this is left as the placeholder below.
NEXT_PUBLIC_API_URL="https://api.example.com"

# Human-readable app name surfaced in the UI and document titles.
NEXT_PUBLIC_APP_NAME="Studio"

# Server-only secret used to sign/verify session tokens. NEVER prefix with
# NEXT_PUBLIC_ and never commit the real value.
AUTH_SECRET="replace-with-a-long-random-string"
